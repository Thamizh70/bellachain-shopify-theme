<article class="product-card"><a class="product-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" loading="lazy">{% else %}<div class="placeholder-jewel">✧</div>{% endif %}<span class="heart" data-wishlist-toggle data-product-handle="{{ product.handle }}" role="button" tabindex="0" aria-label="Add to wishlist">♡</span>{% if product.compare_at_price > product.price %}<span class="sale-tag">Sale</span>{% endif %}</a><div class="product-card__info"><a href="{{ product.url }}"><h3>{{ product.title }}</h3></a><div class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div><div class="rating">★★★★★ <small>({{ product.metafields.reviews.rating_count | default: 'New' }})</small></div></div></article>