<section class="hero"><div class="hero__image" style="background-image:linear-gradient(90deg,rgba(255,232,225,.94) 0%,rgba(255,232,225,.55) 43%,rgba(255,232,225,0) 72%),url('{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 }}{% else %}https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=2000&q=85{% endif %}')"><div class="page-width hero__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p class="hero__sub">{{ section.settings.subheading }}</p><a class="btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }} <span>→</span></a></div></div></section>
{% schema %}{"name":"Hero banner","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Timeless Elegance"},{"type":"text","id":"heading","label":"Heading","default":"Ladies Chains"},{"type":"text","id":"subheading","label":"Subheading","default":"Grace in Every Link"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the Collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero banner"}]}{% endschema %}