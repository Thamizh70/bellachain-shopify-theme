<section class="page-width product-detail"><div class="product-detail__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}">{% endif %}{% for image in product.images offset:1 %}<img src="{{ image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" loading="lazy">{% endfor %}</div><div class="product-detail__info"><p class="eyebrow">{{ product.type }}</p><h1>{{ product.title }}</h1><div class="rating">★★★★★ <small>Customer favourite</small></div><div class="price price--large">{{ product.selected_or_first_available_variant.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div><div class="rte">{{ product.description }}</div>{% form 'product', product %}{% if product.has_only_default_variant == false %}<label for="VariantSelect">Choose option</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} – {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<label for="Quantity">Quantity</label><input id="Quantity" type="number" name="quantity" min="1" value="1"><button class="btn btn--wide" type="submit" {% unless product.available %}disabled{% endunless %}>{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }} · {{ product.selected_or_first_available_variant.price | money }}</button>{% endform %}<p class="trust-note">✓ Secure checkout &nbsp; ✓ Easy returns &nbsp; ✓ Quality assured</p></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}