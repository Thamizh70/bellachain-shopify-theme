<section class="page-width section cart-page"><div class="section-heading"><p class="eyebrow">Your selection</p><h1>Your Cart</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-layout"><div>{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}"><img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.title | escape }}"></a><div class="cart-line__info"><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><p>{{ item.variant.title }}</p><strong>{{ item.final_line_price | money }}</strong><label>Qty <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label><a class="text-link" href="{{ item.url_to_remove }}">Remove</a></div></div>{% endfor %}<button class="btn btn--outline" type="submit" name="update">Update cart</button></div><aside class="order-summary"><h2>Order Summary</h2><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p>Shipping <strong>Calculated at checkout</strong></p><hr><p class="summary-total">Total <strong>{{ cart.total_price | money }}</strong></p><button class="btn btn--wide" type="submit" name="checkout">Proceed to Checkout →</button><p class="trust-note">🔒 Secure checkout</p></aside></div></form>{% else %}<div class="empty-state"><h2>Your cart is waiting for a little sparkle.</h2><a class="btn" href="/collections/all">Continue shopping</a></div>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}