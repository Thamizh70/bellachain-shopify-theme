<section class="section section--soft"><div class="page-width"><div class="section-heading section-heading--row"><div><p class="eyebrow">Customer favourites</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><a class="text-link" href="{{ section.settings.collection.url | default: '/collections/all' }}">View all →</a></div><div class="product-grid">{% assign chosen = section.settings.collection %}{% for product in chosen.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}{% for product in collections.all.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% endfor %}</div></div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},{"type":"text","id":"text","label":"Description","default":"Our most loved styles"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":4,"max":12,"step":4,"default":4}],"presets":[{"name":"Featured products"}]}{% endschema %}