<section class="promo page-width"><div class="promo__copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }} →</a></div><div class="promo__art">✧</div></section>
{% schema %}{"name":"Promo banner","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little something special"},{"type":"text","id":"heading","label":"Heading","default":"Flat 30% OFF"},{"type":"text","id":"text","label":"Text","default":"On All Chains"},{"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Promo banner"}]}{% endschema %}